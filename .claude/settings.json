{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$CLAUDE_PROJECT_DIR; exec \"$r/.claude/hooks/protect-files.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$CLAUDE_PROJECT_DIR; exec \"$r/.claude/hooks/pre-commit-checks.sh\"",
            "timeout": 300,
            "statusMessage": "Running fmt, clippy, test, deny..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.rs)",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$CLAUDE_PROJECT_DIR; exec \"$r/.claude/hooks/format.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting Rust..."
          },
          {
            "type": "command",
            "if": "Write(*.rs)",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$CLAUDE_PROJECT_DIR; exec \"$r/.claude/hooks/format.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting Rust..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$CLAUDE_PROJECT_DIR; exec \"$r/.claude/hooks/skill-extensions.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$CLAUDE_PROJECT_DIR; exec \"$r/.claude/hooks/skill-extensions.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
